# Dockerfile.e2e
FROM python:3.9-slim

# Set the working directory in the container
WORKDIR /tests

# Install Chrome for Selenium tests
RUN apt-get update && apt-get install -y wget gnupg2 unzip \
    && wget https://dl.google.com/linux/direct/google-chrome-stable_current_amd64.deb \
    && dpkg -i google-chrome-stable_current_amd64.deb; apt-get -fy install

# Install ChromeDriver for Selenium
RUN wget -q "https://chromedriver.storage.googleapis.com/$(wget -qO- https://chromedriver.storage.googleapis.com/LATEST_RELEASE)/chromedriver_linux64.zip" \
    && unzip chromedriver_linux64.zip -d /usr/local/bin/ \
    && chmod +x /usr/local/bin/chromedriver

# Copy requirements and test script
COPY requirements.txt /tests/
COPY tests/e2e.py /tests/

# Install required packages
RUN pip install --no-cache-dir -r requirements.txt

# Run the tests when the container launches
CMD ["python", "e2e.py"]
